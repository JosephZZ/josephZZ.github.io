<!DOCTYPE sprite SYSTEM "sprite.dtd">
<sprite fps="1">
	<anim>
		<file name="sr1.png"/>
		<goto anim="0"/>
	</anim>
	<anim>
		<file name="sr1.png"/>
		<file name="sr2.png"/>
		<file name="sr3.png"/>
		<file name="sr4.png"/>
		<onlyonce/>
	</anim>
</sprite>
